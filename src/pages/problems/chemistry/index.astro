---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '题库', href: '/problems' },
  { label: '化学' }
];
---

<MainLayout
  title="化学题库"
  path="/problems/chemistry"
  description="高中化学交互式题目解析，覆盖有机化学、实验装置、分子结构等重难点"
>
  <div class="max-w-5xl mx-auto">
    <Breadcrumb items={breadcrumbs} />

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2 flex items-center gap-3">
        <span aria-hidden="true">🧪</span> 化学题库
      </h1>
      <p class="text-gray-600">交互式化学题目解析</p>
    </div>

    <div class="p-10 bg-green-50 rounded-xl border-2 border-green-200 text-center">
      <div class="text-6xl mb-4" aria-hidden="true">🚧</div>
      <h2 class="text-2xl font-bold mb-2 text-green-800">化学题目即将上线</h2>
      <p class="text-green-700 mb-6 max-w-md mx-auto">
        正在制作有机反应机理、实验装置组合、酸碱中和滴定等精美 SVG 动画解析
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-6">
        {['有机反应机理', '实验装置', '分子结构', '酸碱滴定', '原子轨道'].map(tag => (
          <span class="px-3 py-1 text-sm bg-green-100 text-green-800 rounded-full">{tag}</span>
        ))}
      </div>
      <a
        href="/problems"
        class="inline-block px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-medium"
      >
        查看其他学科题库
      </a>
    </div>
  </div>
</MainLayout>
