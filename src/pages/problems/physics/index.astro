---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '题库', href: '/problems' },
  { label: '物理' }
];
---

<MainLayout
  title="物理题库"
  path="/problems/physics"
  description="高中物理交互式题目解析，覆盖力学、光学、电磁学等重难点"
>
  <div class="max-w-5xl mx-auto">
    <Breadcrumb items={breadcrumbs} />

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-2 flex items-center gap-3">
        <span aria-hidden="true">⚛️</span> 物理题库
      </h1>
      <p class="text-gray-600">交互式物理题目解析</p>
    </div>

    <div class="p-10 bg-orange-50 rounded-xl border-2 border-orange-200 text-center">
      <div class="text-6xl mb-4" aria-hidden="true">🚧</div>
      <h2 class="text-2xl font-bold mb-2 text-orange-800">物理题目即将上线</h2>
      <p class="text-orange-700 mb-6 max-w-md mx-auto">
        正在制作光学全反射、凸透镜成像、交流电路等精美 SVG 动画解析
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-6">
        {['几何光学', '电路分析', '受力分析', '交变电流', '天体运动'].map(tag => (
          <span class="px-3 py-1 text-sm bg-orange-100 text-orange-800 rounded-full">{tag}</span>
        ))}
      </div>
      <a
        href="/problems"
        class="inline-block px-6 py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors font-medium"
      >
        查看其他学科题库
      </a>
    </div>
  </div>
</MainLayout>
