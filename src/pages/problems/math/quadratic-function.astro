---
import MainLayout from '../../../layouts/MainLayout.astro';
import InteractiveQuadratic from '../../../components/explainer/InteractiveQuadratic.tsx';
import Breadcrumb from '../../../components/Breadcrumb.astro';

const title = "二次函数图像与性质";

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '题库', href: '/problems' },
  { label: '数学', href: '/problems/math' },
  { label: title }
];
---

<MainLayout title={title} path="/problems/math/quadratic-function" description="通过拖拽交互观察二次函数图像变化，分步求解析式、顶点坐标和对称轴">
  <article class="prose prose-lg mx-auto max-w-4xl">
    <div class="not-prose mb-6">
      <Breadcrumb items={breadcrumbs} />
    </div>

    <h1 class="text-3xl font-bold mb-6">{title}</h1>

    <div class="not-prose my-8 p-6 bg-blue-50 rounded-xl border border-blue-200">
      <h2 class="text-xl font-bold mb-4">📋 题目</h2>
      <p class="text-lg mb-4">
        已知二次函数 y = ax² + bx + c 的图像经过点 A(1, 0), B(3, 0), C(0, -3)。
      </p>
      <ol class="list-decimal list-inside space-y-2">
        <li>求这个二次函数的解析式</li>
        <li>求该函数的顶点坐标</li>
        <li>求该函数的对称轴方程</li>
      </ol>
    </div>

    <h2 class="text-2xl font-bold mb-4 mt-8">🎮 交互式探索</h2>

    <div class="not-prose my-8">
      <InteractiveQuadratic client:load />
    </div>

    <h2 class="text-2xl font-bold mb-4 mt-12">📝 解题步骤</h2>

    <div class="steps space-y-8">
      <div class="explainer-step">
        <h3 class="text-xl font-semibold text-blue-600 mb-3">步骤 1: 设置解析式</h3>
        <p class="mb-3">
          观察题目条件，点 A(1,0) 和 B(3,0) 是抛物线与 x 轴的交点（即零点）。
        </p>
        <p class="mb-3">
          根据二次函数的<strong>两根式</strong>，可以设：
        </p>
        <div class="math-container">
          <p class="font-mono text-lg">y = a(x - x₁)(x - x₂)</p>
          <p class="font-mono text-lg">y = a(x - 1)(x - 3)</p>
        </div>
        <p class="mt-3 text-gray-600 text-sm">
          💡 提示：当已知零点时，使用两根式最简单！
        </p>
      </div>

      <div class="explainer-step">
        <h3 class="text-xl font-semibold text-blue-600 mb-3">步骤 2: 求参数 a</h3>
        <p class="mb-3">
          将第三个已知点 C(0, -3) 代入解析式：
        </p>
        <div class="math-container space-y-2">
          <p class="font-mono">-3 = a(0 - 1)(0 - 3)</p>
          <p class="font-mono">-3 = a × (-1) × (-3)</p>
          <p class="font-mono">-3 = 3a</p>
          <p class="font-mono text-blue-600 font-bold">a = -1</p>
        </div>
        <p class="mt-3">
          因此，解析式为：<span class="font-mono font-bold text-blue-600">y = -(x - 1)(x - 3)</span>
        </p>
      </div>

      <div class="explainer-step">
        <h3 class="text-xl font-semibold text-blue-600 mb-3">步骤 3: 展开成一般式</h3>
        <p class="mb-3">
          将解析式展开：
        </p>
        <div class="math-container space-y-2">
          <p class="font-mono">y = -(x - 1)(x - 3)</p>
          <p class="font-mono">y = -(x² - 3x - x + 3)</p>
          <p class="font-mono">y = -(x² - 4x + 3)</p>
          <p class="font-mono text-blue-600 font-bold">y = -x² + 4x - 3</p>
        </div>
      </div>

      <div class="explainer-step">
        <h3 class="text-xl font-semibold text-blue-600 mb-3">步骤 4: 求顶点坐标（配方法）</h3>
        <p class="mb-3">
          将一般式配方成<strong>顶点式</strong> y = a(x - h)² + k：
        </p>
        <div class="math-container space-y-2">
          <p class="font-mono">y = -x² + 4x - 3</p>
          <p class="font-mono">y = -(x² - 4x) - 3</p>
          <p class="font-mono">y = -(x² - 4x + 4 - 4) - 3</p>
          <p class="font-mono">y = -(x² - 4x + 4) + 4 - 3</p>
          <p class="font-mono text-blue-600 font-bold">y = -(x - 2)² + 1</p>
        </div>
        <p class="mt-3">
          顶点坐标为：<span class="font-bold text-purple-600">(2, 1)</span>
        </p>
        <p class="mt-2 text-gray-600 text-sm">
          💡 配方技巧：提取二次项系数后，加上一次项系数一半的平方
        </p>
      </div>

      <div class="explainer-step">
        <h3 class="text-xl font-semibold text-blue-600 mb-3">步骤 5: 求对称轴</h3>
        <p class="mb-3">
          <strong>方法一：</strong>从顶点式直接读出
        </p>
        <p class="mb-3">
          顶点式 y = -(x - 2)² + 1 中，顶点横坐标 h = 2
        </p>
        <p class="mb-4">
          对称轴方程：<span class="font-mono font-bold text-orange-600">x = 2</span>
        </p>

        <p class="mb-3">
          <strong>方法二：</strong>利用两根的中点
        </p>
        <p class="mb-3">
          零点 x₁ = 1, x₂ = 3，对称轴是中点：
        </p>
        <div class="math-container">
          <p class="font-mono">x = (x₁ + x₂) / 2 = (1 + 3) / 2 = 2</p>
        </div>
      </div>
    </div>

    <div class="not-prose mt-10 p-6 bg-green-50 rounded-xl border-2 border-green-300">
      <h3 class="text-xl font-bold mb-4 text-green-800">✅ 最终答案</h3>
      <ol class="list-decimal list-inside space-y-3 text-green-900">
        <li class="font-mono">
          <strong>解析式：</strong>y = -x² + 4x - 3 或 y = -(x - 1)(x - 3) 或 y = -(x - 2)² + 1
        </li>
        <li>
          <strong>顶点坐标：</strong>(2, 1)
        </li>
        <li class="font-mono">
          <strong>对称轴：</strong>x = 2
        </li>
      </ol>
    </div>

    <div class="not-prose mt-8 p-6 bg-purple-50 rounded-xl border border-purple-200">
      <h3 class="text-lg font-bold mb-3 text-purple-800">📚 知识点总结</h3>
      <ul class="space-y-2 text-purple-900 text-sm">
        <li><strong>二次函数的三种形式：</strong></li>
        <li class="ml-6">• 一般式：y = ax² + bx + c</li>
        <li class="ml-6">• 两根式：y = a(x - x₁)(x - x₂)  [已知零点时最简单]</li>
        <li class="ml-6">• 顶点式：y = a(x - h)² + k  [顶点为(h, k)]</li>
        <li class="mt-3"><strong>求顶点的方法：</strong></li>
        <li class="ml-6">• 配方法（通用）</li>
        <li class="ml-6">• 公式法：x = -b/(2a), 然后代入求 y</li>
        <li class="ml-6">• 两根的中点（当已知零点时）</li>
      </ul>
    </div>

    <div class="mt-8 flex justify-between">
      <a href="/problems/math" class="text-blue-600 hover:underline">← 返回数学题库</a>
      <a href="/" class="text-blue-600 hover:underline">返回首页 →</a>
    </div>
  </article>
</MainLayout>

<style>
  .prose {
    max-width: none;
  }
</style>
