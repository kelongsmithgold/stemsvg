---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const subjects = [
  { name: '数学', slug: 'math', emoji: '📐', desc: '函数、几何、代数、概率统计', color: 'blue' },
  { name: '物理', slug: 'physics', emoji: '⚛️', desc: '力学、电磁学、光学、热学', color: 'orange' },
  { name: '化学', slug: 'chemistry', emoji: '🧪', desc: '有机化学、无机化学、实验原理', color: 'green' },
  { name: '生物', slug: 'biology', emoji: '🧬', desc: '细胞生物学、遗传与进化、生态学', color: 'purple' }
];

const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '知识点' }
];
---

<MainLayout
  title="知识点"
  path="/knowledge"
  description="高中数理化生核心知识点可视化解析，帮助建立直观的概念理解"
>
  <div class="max-w-5xl mx-auto">
    <Breadcrumb items={breadcrumbs} />

    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-3">知识点</h1>
      <p class="text-gray-600 text-lg">
        数理化生核心概念可视化解析，配合交互式 SVG 图示帮助建立直观理解
      </p>
    </div>

    <!-- 学科列表 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
      {subjects.map(s => (
        <div class="p-6 bg-gray-50 rounded-xl border-2 border-gray-200">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl" aria-hidden="true">{s.emoji}</span>
            <h2 class="text-xl font-bold text-gray-800">{s.name}</h2>
          </div>
          <p class="text-sm text-gray-500 mb-4">{s.desc}</p>
          <div class="inline-flex items-center gap-1 text-xs text-gray-400 bg-gray-200 px-3 py-1 rounded-full">
            🚧 内容制作中
          </div>
        </div>
      ))}
    </div>

    <!-- 提示 -->
    <div class="p-6 bg-blue-50 rounded-xl border border-blue-200 text-center">
      <h3 class="font-bold text-blue-900 mb-2">📅 即将上线</h3>
      <p class="text-blue-800 text-sm">
        知识点专栏正在建设中，首批内容将覆盖高中数学函数与物理光学两大模块。
        目前可先访问
        <a href="/problems" class="underline font-medium hover:text-blue-600">题库</a>
        查看已有的交互式解析题目。
      </p>
    </div>
  </div>
</MainLayout>
